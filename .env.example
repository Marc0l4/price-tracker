# Backend privado — desenvolvimento no host. Nunca versione valores reais.
DATABASE_URL=postgresql://price_tracker_dev:price_tracker_dev_password@localhost:5433/price_tracker_dev?schema=public
# Produção Neon: URL direta, não pooled, com sslmode=require, somente para Prisma CLI.
DIRECT_DATABASE_URL=
SCAVIO_API_KEY=
SCAVIO_AMAZON_TIMEOUT_MS=15000
# Opcional: usado apenas pelo cliente oficial alternativo do Mercado Livre.
MERCADOLIVRE_ACCESS_TOKEN=
API_PORT=3001
CORS_ORIGIN=http://localhost:3000

# Scheduler single-process. Mantenha false em réplicas da API que só atendem leitura.
COLLECTION_SCHEDULER_ENABLED=false
COLLECTION_INTERVAL_MINUTES=30
COLLECTION_TIMEOUT_MS=30000
COLLECTION_STALE_RUN_MINUTES=60
