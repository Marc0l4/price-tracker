{
  "name": "@price-tracker/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run db:generate && tsc -p tsconfig.build.json",
    "test": "vitest run --no-file-parallelism",
    "dev:read-api": "vite-node src/http/read-api.main.ts",
    "start": "node dist/http/read-api.main.js",
    "collect": "vite-node src/collection/collect.cli.ts",
    "db:generate": "prisma --config ../../prisma.config.ts generate",
    "db:migrate": "prisma --config ../../prisma.config.ts migrate deploy"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "pg": "8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pg": "^8.23.1",
    "embedded-postgres": "^18.6.0-beta.19",
    "prisma": "^7.10.1",
    "typescript": "^5.9.3",
    "vitest": "^3.0.8"
  }
}
